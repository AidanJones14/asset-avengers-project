# Copy to .env (gitignored) and fill in the blanks.
# These are the values for running things on your laptop. docker-compose.yml
# sets the few that differ inside the compose network (hostnames, container ports).

# ---- Shared by auth-server and Spring ---------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=endgame-auth
JWT_AUDIENCE=endgame-api
# Optional (these defaults are used when unset): auth-server's own audience, and the staff
# service's, which only staff tokens carry. Each verifier accepts only tokens naming it.
# AUTH_JWT_AUDIENCE=endgame-auth
# STAFF_JWT_AUDIENCE=endgame-staff

# ---- Trading DB (postgres service) and Spring in compose ---------------------
POSTGRES_DB=endgame_test
DB_USERNAME=
DB_PASSWORD=
# Inside compose, Spring reaches the DB by service name on the container port.
DB_URL=jdbc:postgresql://postgres:5432/endgame_test

# ---- Auth DB (auth-db service) -----------------------------------------------
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=
# Laptop port for psql/DBeaver and `npm run start:dev` (5432 is used by another DB).
AUTH_DB_PORT=5433

# ---- auth-server ---------------------------------------------------------------
# Laptop port. Inside compose the server always listens on 3000.
AUTH_SERVICE_PORT=3000
# The `ng serve` origin, used when auth-server runs with `npm run start:dev`.
CORS_ALLOWED_ORIGIN=http://localhost:4200
# Set to 1m locally to test refresh and the idle dialog quickly.
ACCESS_TOKEN_TTL=15m
# Client session settings. Staff MFA sessions use a fixed eight-hour window.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_HOURS=13


# ---- Pricing provider --------------------------------------------------------
# Execution refuses quotes marked stale or older than this duration.
PRICING_MAX_QUOTE_AGE=PT2M
FAUXNANCE_PRICING_API_KEY=

# ---- Admin/analyst reporting and Superset (same root .env) -----------------
# Both Compose stacks read this root file. No second staff .env is required.
# Generate each blank password/secret independently: openssl rand -hex 32
# These initialize new reporting storage; changing them does not rotate existing DB logins.
# Superset deployment logins differ from ADMIN/ANALYST authentication accounts.
ADMIN_DB_NAME=admin_analytics
ADMIN_DB_SUPERUSER=postgres
ADMIN_DB_SUPERUSER_PASSWORD=
ADMIN_DB_USERNAME=endgame_admin
ADMIN_DB_PASSWORD=
ADMIN_DB_PORT=5434
ETL_DB_USERNAME=analytics_worker
ETL_DB_PASSWORD=
INTERNAL_API_PORT=8085
# Developer image tag; Jenkins sets a unique tag for each isolated staff build.
STAFF_IMAGE_TAG=local
INTERNAL_UI_PORT=8086
# Use 0.0.0.0 for VM/LAN browser access; database/API bindings remain local.
STAFF_BIND_ADDRESS=127.0.0.1
SUPERSET_PORT=8088
# auto uses the staff page host with SUPERSET_PORT for the embedded dashboard URL.
SUPERSET_PUBLIC_URL=auto
# Add http://HOST_IP:8086 for each host address used by staff browsers.
SUPERSET_EMBED_ORIGINS=http://localhost:8086,http://localhost:5174,http://localhost:8084,http://localhost:4200
SUPERSET_METADATA_DB=superset_metadata
SUPERSET_METADATA_USER=superset_metadata
SUPERSET_METADATA_PASSWORD=
SUPERSET_REPORTING_USER=superset_reader
SUPERSET_REPORTING_PASSWORD=
SUPERSET_SECRET_KEY=
SUPERSET_GUEST_TOKEN_SECRET=
SUPERSET_ADMIN_USER=dashboard-author
SUPERSET_ADMIN_PASSWORD=
# Shared only by auth-server and Superset for one-use J.A.R.V.I.S. SSO handoffs.
# Generate a stable value: openssl rand -hex 32
SUPERSET_SSO_SECRET=
SUPERSET_SERVICE_USER=internal-api
SUPERSET_SERVICE_PASSWORD=
TRADING_NETWORK=trading_platform_network

# Auth-only AES-256 key for MFA secrets. Generate: openssl rand -base64 32
# Keep stable across restarts; losing/changing it prevents enrolled users signing in.
MFA_ENCRYPTION_KEY=

# Temporary, local development only: true lets the dev.*@example.com staff accounts sign in
# without an authenticator code (auth-server/src/auth/dev-mfa-bypass.ts). Never on a shared machine.
# DEV_MFA_BYPASS=true

# Resend password resets: backend only. Existing secret name is case-sensitive.
Email_Service=
# Use a sender on a verified domain before emailing real users.
# Test sender: only delivers to the email on your Resend account.
# For other recipients verify your own domain in Resend, then use e.g.
# EMAIL_FROM=Endgame Trading <security@your-verified-domain.com>
EMAIL_FROM=Asset Avengers <onboarding@resend.dev>
EMAIL_RESET_TEMPLATE_ID=

# LogoKit browser-safe Logo API token (pk_), never a secret sk_ token.
LOGOKIT_PUBLISHABLE_TOKEN=pk_REPLACE_WITH_YOUR_LOGOKIT_TOKEN
