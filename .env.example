# ============================================================
# Application Configuration
# ============================================================

# Database Connection (for backend)
DB_URL=jdbc:postgresql://ip:port/Endgame_TEST_DB
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DRIVER_CLASS_NAME=org.postgresql.Driver

# PostgreSQL Configuration (for containers)
POSTGRES_DB=Endgame_TEST_DB

# Analytics Database
ANALYTICS_DB=Endgame_ANALYTICS_DB

# ============================================================
# ETL Configuration (Analytics Pipeline)
# ============================================================

# Production Database Settings (READ-ONLY for ETL)
# Used by the ETL service to read data from production
PROD_DB_HOST=postgres
PROD_DB_PORT=5432
ETL_USER=etl_user
ETL_PASSWORD=secure_etl_password_change_me

# Analytics Database Settings (for ETL writer)
# Used by the ETL service to write data to analytics database
ANALYTICS_DB_HOST=postgres-analytics
ANALYTICS_DB_PORT=5432
ANALYTICS_ETL_USER=analytics_etl_user
ANALYTICS_ETL_PASSWORD=secure_analytics_etl_password_change_me

# ============================================================
# Metabase Configuration (Reporting & Dashboards)
# ============================================================

# Metabase Database Backend (stored on analytics database)
METABASE_DB=Endgame_ANALYTICS_DB
METABASE_DB_USER=metabase_user
METABASE_DB_PASSWORD=secure_metabase_password_change_me

# Metabase Admin Account (set on first startup)
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=changeme

# ============================================================
# IMPORTANT SECURITY NOTES
# ============================================================
# 1. Change all passwords before deploying to production
# 2. ETL_USER has SELECT-only access to production database
# 3. ANALYTICS_ETL_USER has full access to analytics schema only
# 4. METABASE_DB_USER has SELECT-only access to analytics schema
# 5. Store this file securely and never commit actual passwords to git
