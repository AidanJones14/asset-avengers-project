# Copy to .env (gitignored) and fill in the blanks.
# These are the values for running things on your laptop. docker-compose.yml
# sets the few that differ inside the compose network (hostnames, container ports).

# ---- Shared by auth-server and Spring ---------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=endgame-auth
JWT_AUDIENCE=endgame-api

# ---- Trading DB (postgres service) and Spring in compose ---------------------
POSTGRES_DB=Endgame_TEST_DB
DB_USERNAME=
DB_PASSWORD=
# Inside compose, Spring reaches the DB by service name on the container port.
DB_URL=jdbc:postgresql://postgres:5432/Endgame_TEST_DB

# ---- Auth DB (auth-db service) -----------------------------------------------
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=
# Laptop port for psql/DBeaver and `npm run start:dev` (5432 is used by another DB).
AUTH_DB_PORT=5433

# ---- auth-server ---------------------------------------------------------------
# Laptop port. Inside compose the server always listens on 3000.
AUTH_SERVICE_PORT=3000
# The `ng serve` origin, used when auth-server runs with `npm run start:dev`.
CORS_ALLOWED_ORIGIN=http://localhost:4200
# Set to 1m locally to test refresh and the idle dialog quickly.
ACCESS_TOKEN_TTL=15m
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_HOURS=13

