# The auth server reads ../.env (the repo root), not a file in this folder.
# This lists the keys it uses. Copy them into ../.env and fill them in.

# Shared with Spring: must equal Spring's jwt.shared-secret. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=endgame-auth
JWT_AUDIENCE=endgame-api
# Optional (these defaults are used when unset): auth-server's own audience, and the staff
# service's, which only staff tokens carry. Each verifier accepts only tokens naming it.
# AUTH_JWT_AUDIENCE=endgame-auth
# STAFF_JWT_AUDIENCE=endgame-staff
CORS_ALLOWED_ORIGIN=http://localhost:4200

AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=
# Port on your laptop for psql/DBeaver; 5432 is likely your transactional DB
AUTH_DB_HOST_PORT=5433

AUTH_SERVICE_PORT=3000
ACCESS_TOKEN_TTL=15m
# Optional, these are the defaults
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_HOURS=12

# Auth-only MFA secret encryption key; configure it in the root .env only.
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# Resend credentials/configuration belong only in ../.env.
Email_Service=
# Test sender: only delivers to the email on your Resend account.
# For other recipients verify your own domain in Resend, then use e.g.
# EMAIL_FROM=Endgame Trading <security@your-verified-domain.com>
EMAIL_FROM=Asset Avengers <onboarding@resend.dev>
EMAIL_RESET_TEMPLATE_ID=
