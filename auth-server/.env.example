# The auth server reads ../.env (the repo root), not a file in this folder.
# This lists the keys it uses. Copy them into ../.env and fill them in.

# Shared with Spring: must equal Spring's jwt.shared-secret. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=endgame-auth
JWT_AUDIENCE=endgame-api
CORS_ALLOWED_ORIGIN=http://localhost:4200

AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=
# Port on your laptop for psql/DBeaver; 5432 is likely your transactional DB
AUTH_DB_HOST_PORT=5433

AUTH_SERVICE_PORT=3000
ACCESS_TOKEN_TTL=15m
# Optional, these are the defaults
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_HOURS=12
