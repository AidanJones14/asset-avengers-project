  'themeCSS': '.node rect, .node path, .outer, .inner, g.classGroup rect, rect { stroke: #cac4a2 !important; stroke-width: 2px !important; filter: none !important; opacity: 1 !important; } .edgeLabel span, .edgeLabel { color: #1d1d1d !important; }'
