classDiagram
	class User {
		-userId: String
		-fullName: String
        -role: String
		-email: String
        %% -accounts: Account[]
        #get...()
        #set...()	
	}

    class UserService {
        <<static>>
        +register(Credential) 
        %%credential: 
		+validateCredential()
		+signIn(Credential) 
        +signOut()
        +changePassword(Credential) 
		+trackStock(Instrument) 
        %%instrument: 
    }

	class Credential {
		-username: String
		-lastSignInAt: DateTime
	}

	class Account {
		-accountId: String
		-cashBalance: Decimal
		-openedOn: Date
        %% -type: String
        -permission: String
		+updateCashBalance(amount: Decimal)
		+checkRules(order: Order)
		+retrieveHistory()
	}

	class AnalyzeAccountService {
		%% -segment: String
		%% -name: String
		%% -minAccountValue: Decimal
		%% -maxAccountValue: Decimal
        <<static>>
		+classifySize(Account)
        +classifyActivity(Account)
	}

	class Rules {
		+ruleId: String
		+description: String
		+isActive: Boolean
		+checked(order: Order, account: Account)
	}

	class Instrument {
		-instrumentId: String
        -symbol: String
		-name: String
        -type: String
        -currency: String
		-marketPrice: Decimal
        -active: boolean
		+priced()
        +isActive()
	}

	class Order {
		-orderId: String
		-orderType: String
        -side: String
        %% -status: Status
		-quantity: int
		-limitPrice: Decimal
		-submittedAt: DateTime
		+submit()
		+buy()
		+sell()
		+changeStatus(status: Status)
		+execute()
	}

	class Status {
		<<enumeration>>
		PENDING
		CHECKED
		EXECUTED
		REJECTED
		CANCELLED
	}

	class Record {
		+recordId: String
		+recordType: String
		+createdAt: DateTime
		+update()
	}

	class Holdings {
		-holdingId: String
		-quantity: int
		-averageCost: Decimal
		-marketValue: Decimal
		+update(quantity: int, price: Decimal)
	}

	class OrderHistory {
		+historyId: String
		+retrieve()
		+addRecord(record: Record)
	}

	class AuditLog {
		-logId: String
		-eventType: String
		+recordEvent(Record)
	}

	class Watchlist {
		+watchlistId: String
		+name: String
		+analyze()
		+trackStock(instrument: Instrument)
	}

	User "1" *-- "1" Credential : authenticates with
    User -- UserService 
	User "1" *-- "*" Account
	User "1" *-- "0..1" Watchlist
	User "1" *-- "1" AuditLog : audited by

	Account -- AnalyzeAccountService : categorized by
	Account "1" *-- "0..*" Holdings : maintains
	Account "1" *-- "1" OrderHistory : stores
	Account "1" ..> Rules : checked against

	OrderHistory "1" *-- "0..*" Record : contains
	AuditLog "1" *-- "0..*" Record : logs

	Watchlist "1" o-- "0..*" Instrument : tracks
	Holdings "1" --> "1" Instrument
	Order "1" --> "1" Instrument : targets
	Order "1" --> "1" Status
	Order "1" --> "1" Account : submitted from
	Rules "1" ..> Order : validates
	Order "1" ..> Record : creates
