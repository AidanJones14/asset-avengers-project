# Copy to docker/admin-analytics/.env. Shared JWT/trading DB values are read from
# the root .env first; this file adds the separate staff-stack configuration.
ADMIN_DB_NAME=admin_analytics
ADMIN_DB_SUPERUSER=postgres
ADMIN_DB_SUPERUSER_PASSWORD=
ADMIN_DB_USERNAME=endgame_admin
ADMIN_DB_PASSWORD=
ADMIN_DB_PORT=5434
ETL_DB_USERNAME=analytics_worker
ETL_DB_PASSWORD=
INTERNAL_API_PORT=8085
INTERNAL_UI_PORT=8086
SUPERSET_PORT=8088
SUPERSET_PUBLIC_URL=http://localhost:8088
SUPERSET_EMBED_ORIGINS=http://localhost:8086,http://localhost:5174,http://localhost:8084,http://localhost:4200
SUPERSET_METADATA_DB=superset_metadata
SUPERSET_METADATA_USER=superset_metadata
SUPERSET_METADATA_PASSWORD=
SUPERSET_REPORTING_USER=superset_reader
SUPERSET_REPORTING_PASSWORD=
# Generate each secret independently, for example: openssl rand -hex 32
SUPERSET_SECRET_KEY=
SUPERSET_GUEST_TOKEN_SECRET=
SUPERSET_ADMIN_USER=dashboard-author
SUPERSET_ADMIN_PASSWORD=
SUPERSET_SERVICE_USER=internal-api
SUPERSET_SERVICE_PASSWORD=
